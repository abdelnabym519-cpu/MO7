# =============================================================================
# MO7 production deployment contract
# =============================================================================
# Rendered by prod_bootstrap.sh. This file is the single source of truth for
# every Phase 32 tool: paths, ports, release identity and policy locations.
# It holds NO secrets (see secrets/secrets.env, mode 0600).
#
# Deployment-host difference from the container image: the image bakes the
# frontend bundle at /app/web and installs Python into /usr/local. Here each
# release is self-contained under releases/<release-id>/ (artifact + venv +
# materialised web bundle + start scripts) and `current` is a symlink that
# points at the promoted release. Everything else mirrors the image: the same
# supervisord process model, the same uvicorn command line, the same
# `node server.js` frontend, the same JSON settings under the data root.
# =============================================================================

PROD_ENVIRONMENT=production
PROD_ROOT=@PROD_ROOT@
PROD_RELEASE_ID=@RELEASE_ID@
PROD_VERSION=@VERSION@
PROD_SOURCE_COMMIT=@SOURCE_COMMIT@
PROD_ARTIFACT_NAME=@ARTIFACT_NAME@
PROD_ARTIFACT_SHA256=@ARTIFACT_SHA256@

# --- layout ------------------------------------------------------------------
PROD_RELEASES_DIR=@PROD_ROOT@/releases
PROD_CURRENT_LINK=@PROD_ROOT@/current
PROD_HOME=@PROD_ROOT@/home
PROD_RUN=@PROD_ROOT@/run
PROD_ETC=@PROD_ROOT@/etc
PROD_BIN=@PROD_ROOT@/bin
PROD_SECRETS=@PROD_ROOT@/secrets
PROD_BACKUPS=@PROD_ROOT@/backups
PROD_EVIDENCE=@PROD_ROOT@/evidence
PROD_LOG_DIR=@PROD_ROOT@/run/supervisor
PROD_METRICS_DIR=@PROD_ROOT@/run/metrics
PROD_ALERTS_DIR=@PROD_ROOT@/run/alerts
PROD_HARNESS=@PROD_ROOT@/harness

# --- serving -----------------------------------------------------------------
# The API is bound inside the loopback range but *not* on 127.0.0.1: the
# platform's port bridge dials 127.0.0.1 for every listening port (verified: a
# bridge socket is live for the API port and answers as uvicorn), so a plain
# 127.0.0.1 bind is published by the platform edge. Binding the private
# interface leaves the bridge target dead while the frontend proxy keeps a
# working address.
PROD_BACKEND_HOST=127.0.0.2
PROD_BACKEND_PORT=8001
PROD_BACKEND_WORKERS=1
PROD_FRONTEND_HOST=0.0.0.0
PROD_FRONTEND_PORT=3782
PROD_PUBLIC_ORIGIN=@PUBLIC_ORIGIN@

# Validation-only TLS ingress (self-signed; NEVER presented as production TLS).
# Production TLS terminates at the platform edge named by PROD_PUBLIC_ORIGIN.
PROD_TLS_VALIDATION_PORT=8443
PROD_TLS_VALIDATION_ORIGIN=https://127.0.0.1:8443

# --- process supervision -----------------------------------------------------
# Ops tooling lives in its own virtualenv so process supervision and the
# operational tools never depend on a release runtime (and survive rollbacks).
PROD_OPS_VENV=@PROD_ROOT@/ops-venv
PROD_SUPERVISORD=@PROD_ROOT@/ops-venv/bin/supervisord
PROD_SUPERVISORCTL=@PROD_ROOT@/ops-venv/bin/supervisorctl
PROD_SUPERVISOR_SOCK=@PROD_ROOT@/run/supervisor.sock
PROD_SUPERVISOR_PID=@PROD_ROOT@/run/supervisord.pid
PROD_SUPERVISOR_LOG=@PROD_ROOT@/run/supervisord.log
PROD_MIN_FDS=65536
# Per-program file-descriptor limit enforced by supervisord (rlimit_nofile).
PROD_RLIMIT_NOFILE=65536
PROD_STOP_WAIT=20
# The platform sandbox has no usable init system, so supervisord is started by
# `bin/prod.sh start` and kept alive by bin/prod_watchdog.py. A real host with
# systemd installs etc/systemd/mo7-production.service instead (shipped, not
# installed here).
PROD_SERVICE_MANAGER=supervisord-with-watchdog

# --- data / secrets ----------------------------------------------------------
PROD_DATA_MODE=production
# Guards enforced by the release start scripts (and therefore by the process
# manager): a missing/empty auth secret or an unwritable data root must stop the
# program with a clear FATAL line instead of silently regenerating a secret or
# serving 500s.
PROD_REQUIRED_SECRETS=auth_secret
PROD_REQUIRE_DATA_WRITABLE=1

# --- policy files ------------------------------------------------------------
PROD_BACKUP_POLICY=@PROD_ROOT@/etc/backup-policy.json
PROD_ALERTS_POLICY=@PROD_ROOT@/etc/alerts.json
# API documentation surface decision (see the runbook): the surface is
# operator-only because the API is loopback-bound and the public origin
# proxies /api/* only. Enforced by the network boundary checks.
PROD_API_DOCS_DECISION=loopback-operator-only
PROD_WATCHDOG_PID=@PROD_ROOT@/run/watchdog.pid
PROD_WATCHDOG_LOG=@PROD_ROOT@/run/watchdog.log
PROD_DEPLOY_LOG=@PROD_ROOT@/run/deployments.log
PROD_CURRENT_RELEASE_FILE=@PROD_ROOT@/run/current-release.json
PROD_SMOKE_PORT=8099
